<%- include('../partials/head')%>
<body>
<%- include('../partials/header')%>
    <div class="content-wrapper">
<main>
    <div class="post-maker-container">
    <h2>Create a new post</h2>
    <form action="/newpost" method="POST">
        <label>Add Text:</label><br>
        <textarea autofocus rows="5" cols="50" maxlength="500" id="message" name="message" autocomplete="off"></textarea><br>
        <!-- <label>Add Image:</label><br>
        <input type="file" name="myImage" accept="image/*"><br> -->
        <input type="submit" class="btn" value="Post">
    </form>
    </div>
    <!-- End of post-maker -->
    <br>
    <hr>
    <h2>Recent Posts</h2>
    <ul class="post-timeline-container">
        <% postData.forEach(post=>{ %>
        <!-- loop housing each post's relevant info within html elements -->
            <li class="timeline-post">
                <div class="post-user-info">
                <% if(post.imagePath){ %>
                        <img src="<%= post.imagePath %>" alt="" class="post-user-avatar">
                    <% } else { %>
                        <p>sorry no image available</p>
                    <% } %>
                <p>
                    <strong>
                    <%= post.postedBy %>
                    <!-- displays the post author's username -->
                     </strong>
                </p>
                </div>
                <p class="post-text">
                    <%= post.message %>
                    <!-- displays the post's text content -->
                </p>
                <button class="likeBtn" onclick="location.href='/like?postid=<%= post._id %>'">&#x2665 <%= post.likes%></button>
                <!-- '&#x2665' is a heart icon -->
                <a class="commentBtn" href="/viewpost?postid=<%= post._id %>">Comment (<%= post.comments.length%>)</a>
                <!-- button indicating user can comment on the post and noting how many comments currently exist on said post -->
            </li>
        <% }) %>
    </ul>
    <ul class="timeline-nav-container">
        <li id="timeline-back-button"><a href="#">&laquo;</a></li>
        <li><a href="#">1</a></li>
        <li><a href="#">2</a></li>
        <li><a href="#">3</a></li>
        <li><a href="#">4</a></li>
        <li><a href="#">5</a></li>
        <li id="timeline-forward-button"><a href="#">&raquo;</a></li>
        <!-- navigation to allow user to look through further posts -->
        <!-- see if btn class stylings can be used -->
    </ul>
    <!-- Based on styling from: https://www.w3schools.com/css/css3_pagination_styles.asp -->
</main>
</div>
</body>
<%- include('../partials/footer')%>