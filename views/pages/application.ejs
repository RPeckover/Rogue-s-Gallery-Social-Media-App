<%- include('../partials/head')%>
<body>
    <%- include('../partials/header')%>
    <div class="content-wrapper">
<main>
    <!-- <h4>Username: <%= username %></h4> -->
    <div class="post-maker-container">
    <h2>Create a new post</h2>
    <form action="/newpost" enctype="multipart/form-data" method="POST">
        <label>Add Text:</label><br>
        <input required type="text" id="message" name="message"><br>
        <label>Add Image:</label><br>
        <input type="file" name="myImage" accept="image/*"><br>
        <input class="btn" type="submit" value="Post">
    </form>
    </div>
    <!-- End of post maker -->
    <br>
    <hr>
    <h2>Recent Posts</h2>
    <div class="post-timeline-container">
        <!-- class allowing posts to display in a user friendly manner -->
    <ul>
        <% postData.forEach(post=>{ %>
            <li>
                <% if(post.imagePath){ %>
                        <img src="<%= post.imagePath %>" alt="" class="post-image-thumbnail">
                    <% } else { %>
                        <p>sorry no image available</p>
                    <% } %>
                <p>
                    <%= post.message %>
                </p>
                <p>
                    <%= post.postedBy %>
                </p>
                <button onclick="location.href='/like?postid=<%= post._id %>'">&#x2665 <%= post.likes%></button>
                <!-- '&#x2665' is a heart icon -->
                <a href="/viewpost?postid=<%= post._id %>">View post</a>
            </li>
        <% }) %>
    </ul>
    </div>
</div>
</main>
</body>
<%- include('../partials/footer')%>
