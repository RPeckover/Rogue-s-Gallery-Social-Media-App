<%- include('../partials/head')%>
<body>
    <%- include('../partials/header')%>
    <div class="content-wrapper">
<main>
    <h2>Welcome to your dressing room</h2>
    <div class="profile-form-container">
    <h4>Profile info</h4>
    <form action="/profile-edit" enctype="multipart/form-data" method="POST">
        <label for="avatar">Update profile picture:</label>
        <input type="file" name="avatar" accept="image/*">
        <br>
        <label for="username">Change username:</label>
        <input type="text" placeholder="Username" name="username">
        <br>
        <label for="password">Change password:</label>
        <input type="text" placeholder="Password" name="password">
        <br>
        <input type="submit" class="btn" value="Update Profile">
        <!-- Double check if 'value=Post' is what I want here -->
        <!-- Add classes to the inputs? -->
      </div>
    </form>
</div>
</main>
</body>
    <%- include('../partials/footer')%>
