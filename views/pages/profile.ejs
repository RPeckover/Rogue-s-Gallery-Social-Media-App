<%- include('../partials/head')%>
<body>
    <%- include('../partials/header')%>
<div class="content-wrapper">
<main>
    <h2>Welcome to your dressing room</h2>
    <div class="profile-form-container">
    <h4>Profile info</h4>
    <form action="/profile-edit" enctype="multipart/form-data" method="POST">
        <label for="myPFP">Update profile picture:</label>
        <input type="file" name="myPFP" accept="image/*">
        <br>
        <label for="username">Change username:</label>
        <input type="text" placeholder="Username" name="username">
        <br>
        <label for="password">Change password:</label>
        <input type="text" placeholder="Password" name="password">
        <br>
        <input type="submit" class="btn" value="Update Profile"> 
        <!-- Add classes to the inputs? -->
    </form>
    </div>
    <br>
    <p>If you wish to erase your account, use the tickbox and click the button below</p><br>
    <label for="eraseAgree">I wish to permanently erase my profile and posts</label> 
    <input type="checkbox" id="eraseAgree" class="eraseTickbox">
    <!-- checkbox added as an extra layer to prevent the user from accidentally erasing their account -->
    <a id="eraseBtn" class="eraseBtn" onclick="eraseUser()">Delete your Profile</a>
    <!-- if 'eraseAgree' tickbox is toggled and 'eraseBtn' button is clicked, erases the user's account -->
</main>
</div>
</body>
<br>
    <%- include('../partials/footer')%>
