<%- include('../partials/head')%>
<body>
    <%- include('../partials/header')%>
    <div class="content-wrapper">
<main>
     <h2>Viewing Post</h2>
    <div>
        <% if(post.imagePath){ %>
                <img src="<%= post.imagePath %>" alt="" class="post-user-avatar">
            <% } else { %>
                <p>No image available</p>
                <!-- Review images and how I want to handle them -->
            <% } %>
        <p>
            <%= post.message %>
            <!-- displays the post author's username -->
        </p>
        <p>
            <%= post.postedBy %>
            <!-- displays the post's text content -->
        </p>
        <h4>Hecklers (Comments) <%= post.comments.length %></h4>
        <!-- displays the number of comments -->
        <ul>
            <% post.comments.forEach(comment=>{ %>
                <!-- loop housing each comment's relevant info within html elements -->
                <li>
                    <p>
                        <%= comment.commentBy %>
                        <!-- list commenter of existing comment -->
                    </p>
                    <p>
                        <%= comment.message %>
                        <!-- list existing comments -->
                    </p>
                </li>
            <% }) %>
        </ul>
        <form action="/comment" method="POST">
        <!-- form to input a new comment -->
            <label>Add a Comment</label><br>
            <input type="hidden" id="postid" name="postid" value="<%= post._id %>">
            <input type="text" id="comment" name="comment"><br>
            <input type="submit" class="btn" value="Comment">
        </form>
        <a href="/application">Back to post timeline</a>
    </div>
</main>
</div>
</body>
<!-- <br> -->
<%- include('../partials/footer')%> 
