<header>
  <h1>Rogue's Gallery</h1>
  <div class="header-user-text">
    <% if(isLoggedIn){ %>
        <h4 class=nav-text>Username: <%= username %></h4>
    <% } else { %>
        <h4 class=nav-text> Welcome! Log in to view the gallery</h4>
    <% } %>
  </div>
  <nav class="full-nav">
    <ul>
      <% if(isLoggedIn){ %>
      <li><a class=nav-text href="/application">Posts</a></li>
      <li><a class=nav-text href="/logout">Logout</a></li>
      <li><a class=nav-text href="/profile">Profile</a></li>
      <% } else { %>
      <li><a class=nav-text href="/register">Register</a></li>
      <li><a class=nav-text href="/login">Login</a></li>
      <% } %>
      <li><a class=nav-text href="/about">About</a></li>
    </ul>
  </nav>
</header>
